        {
            "description": "Five days of lights, crows, dogs, and brothers and sisters. Learn what each day means.",
            "id": "tihar",
            "min_age_band": "seedling",
            "mission": "Say 'Shuva Tihar' to someone you love and record it for the Family Circle.",
            "scenes": [
                {
                    "audio_url": "/audio/nepal-v1/quest_tihar_1_np.m4a",
                    "id": "tihar-1",
                    "text_en": "Tihar is here! The house is bright, hearts are happy.",
                    "text_np_romanized": "Tihar aayo! Ghar ujyalo, mann khusi."
                },
                {
                    "audio_url": "/audio/nepal-v1/quest_tihar_2_np.m4a",
